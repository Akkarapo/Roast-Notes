F9E8F;fontColor=#FFFFFF;fontSize=22;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1310" width="164" height="56" as="geometry"/></mxCell><mxCell id="n93" value="แอดมินเปลี่ยนออเดอร์เป็น&lt;br&gt;&lt;b&gt;&quot;ได้รับแล้ว&quot; (delivered)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Order::markDelivered()&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#615CF6;strokeColor=#615CF6;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="1450" width="250" height="100" as="geometry"/></mxCell><mxCell id="n94" value="&lt;b&gt;คำนวณยอดสะสม&lt;/b&gt;&lt;br&gt;spend = SUM(orders.total)&lt;br&gt;WHERE user_id = ?&lt;br&gt;AND status = 'delivered'" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEEEFC;strokeColor=#615CF6;strokeWidth=1.5;fontColor=#222222;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="1450" width="270" height="100" as="geometry"/></mxCell><mxCell id="n95" value="&lt;b&gt;หาระดับที่ได้&lt;/b&gt;&lt;br&gt;earned = ระดับที่ min_spend ≤ spend&lt;br&gt;ที่สูงที่สุด" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEEEFC;strokeColor=#615CF6;strokeWidth=1.5;fontColor=#222222;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="1450" width="280" height="100" as="geometry"/></mxCell><mxCell id="n96" value="earned สูงกว่า&lt;br&gt;ระดับปัจจุบัน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#8F8CF7;strokeColor=#8F8CF7;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="1440" width="220" height="120" as="geometry"/></mxCell><mxCell id="n97" value="&lt;b&gt;เลื่อนระดับ&lt;/b&gt;&lt;br&gt;UPDATE users&lt;br&gt;SET member_tier_id = earned" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E3F5EE;strokeColor=#2F9E8F;strokeWidth=1.5;fontColor=#222222;fontSize=15;fontFamily=Helvetica;" vertex="1" par