"n112" value="≥ ฿50,000" style="whiteSpace=wrap;html=1;fillColor=#EEEEFC;strokeColor=#FFFFFF;fontColor=#222222;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="1795" width="250" height="40" as="geometry"/></mxCell><mxCell id="n113" value="ส่วนลด" style="whiteSpace=wrap;html=1;fillColor=#615CF6;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="1675" width="110" height="40" as="geometry"/></mxCell><mxCell id="n114" value="0%" style="whiteSpace=wrap;html=1;fillColor=#EEEEFC;strokeColor=#FFFFFF;fontColor=#222222;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="1715" width="110" height="40" as="geometry"/></mxCell><mxCell id="n115" value="5%" style="whiteSpace=wrap;html=1;fillColor=#EEEEFC;strokeColor=#FFFFFF;fontColor=#222222;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="1755" width="110" height="40" as="geometry"/></mxCell><mxCell id="n116" value="10%" style="whiteSpace=wrap;html=1;fillColor=#EEEEFC;strokeColor=#FFFFFF;fontColor=#222222;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="1795" width="110" height="40" as="geometry"/></mxCell><mxCell id="n117" value="ซื้อล็อตหายากก่อน" style="whiteSpace=wrap;html=1;fillColor=#615CF6;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650" y="1675" width="190" height="40" as="geometry"/></mxCell><mxCell id="n118" value="—" style="whiteSpace=wrap;html=1;fillColor=#EEEEFC;strokeColor=#FFFFFF;fontColor=#222222;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650" y="1715" width="190" height="40" as="geometry"/></mxCell><mxCell id="n119" value="—" style="whiteSpace=wrap;html=1;fillColor=#EEEEFC;strokeColor=#FFFFFF;fontColor=#222222;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650" y="1755" width="190" height="40" as="geometry"/></mxCell><mxCell id="n120" value="✓ ก่อนคนอื่น 14 วัน" style="whiteSpace=wrap;html=1;fillColor=#EEEEFC;strokeColor=#FFFFFF;fontColor=#222222;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650" y="1795" width="190" height="40" as="geometry"/></mxCell><mxCell id="n121" value="สมาชิกใหม่เริ่มที่ Bean (users.member_tier_id default = 1) · แอดมินปรับระดับเองได้ แต่การคำนวณครั้งถัดไปเลื่อนขึ้นได้อย่างเดียว" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#8A8A9A;fontStyle=0;fontFamily=Helvetica;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="1843.0" width="780" height="24" as="geometry"/></mxCell><mxCell id="n122" value="ระดับมีผลตรงไหน" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#222222;fontStyle=1;fontFamily=Helvetica;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="960" y="1638.0" width="300" height="24" as="geometry"/></mxCell><mxCell id="n123" value="&lt;b&gt;1. ส่วนลดตอนคิดราคา&lt;/b&gt; — กฎตัวที่ 3 ของ pipeline&lt;br&gt;ซื้อ X แถม Y → คูปอง → &lt;b&gt;LoyaltyTierRule&lt;/b&gt;&lt;br&gt;ส่วนลด = (ยอดสินค้า − ส่วนลดก่อนหน้า) × discount_percent ÷ 100 ปัดลง&lt;br&gt;บันทึกใน order_discounts (source = 'loyalty')" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEEEFC;strokeColor=#615CF6;strokeWidth=1.5;fontColor=#222222;fontSize=15;fontFamily=Helvetica;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="960" y="1675" width="780" height="110" as="geometry"/></mxCell><mxCell id="n124" value="&lt;b&gt;2. ล็อตหายาก (early access)&lt;/b&gt;&lt;br&gt;ถ้า products.exclusive_until &amp;gt; now() ซื้อได้เฉพาะระดับที่ early_access = true&lt;br&gt;ระดับอื่นเห็นสินค้าแต่ใส่ตะกร้าไม่ได้ (ตรวจซ้ำตอนยืนยันออเดอร์)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEEEFC;strokeColor=#615CF6;strokeWidth=1.5;fontColor=#222222;fontSize=15;fontFamily=Helvetica;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="960" y="1800" width="780" height="95" as="geometry"/></mxCell><mxCell id="n125" value="นับเฉพาะออเดอร์ที่ได้รับแล้ว · ยกเลิก/ยังไม่ได้รับไม่นับ · ยอดสะสมคำนวณสดจาก orders ไม่เก็บซ้ำ (ไม่มีข้อมูลซ้ำซ้อน)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#8A8A9A;fontStyle=0;fontFamily=Helvetica;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="960" y="1913.0" width="780" height="24" as="geometry"/></mxCell><mxCell id="n126" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B42CE6;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="40" y="2170" width="1760" height="900" as="geometry"/></mxCell><mxCell id="n127" value="Mermaid" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#B42CE6;strokeColor=#B42CE6;fontColor=#FFFFFF;fontSize=22;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="2100" width="125" height="56" as="geometry"/></mxCell><mxCell id="n128" value="users" style="whiteSpace=wrap;html=1;fillColor=#615CF6;strokeColor=#615CF6;fontColor=#FFFFFF;fontStyle=1;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="2240" width="488" height="36" as="geometry"/></mxCell><mxCell id="n129" value="big-int" style="whiteSpace=wrap;html=1;fillColor=#EEEEFC;strokeColor=none;fontColor=#222222;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="2280" width="130" height="38" as="geometry"/></mxCell><mxCell id="n130" value="&lt;u&gt;id&lt;/u&gt;" style="whiteSpace=wrap;html=1;fillColor=#EEEEFC;strokeColor=none;fontColor=#222222;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="774" y="2280" width="260" height="38" as="geometry"/></mxCell><mxCell id="n131" value="PK" style="whiteSpace=wrap;html=1;fillColor=#EEEEFC;strokeColor=none;fontColor=#222222;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1038" y="2280" width="90" height="38" as="geometry"/></mxCell><mxCell id="n132" value="tiny-int" style="